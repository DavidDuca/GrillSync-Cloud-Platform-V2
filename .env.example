# ─────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/grillsync_cloud
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS. Use * to allow all.
ALLOWED_ORIGINS=*

# Public base URL embedded into generated sync scripts.
# Leave blank to auto-detect from request headers (x-forwarded-proto/host).
PUBLIC_BASE_URL=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
SYNC_RATE_LIMIT_MAX=200
