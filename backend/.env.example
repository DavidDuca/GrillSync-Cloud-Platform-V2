# Server
PORT=4000
NODE_ENV=production

# Mongo
MONGO_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/grillsync_cloud

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Where this backend is reachable from the POS / sync scripts
PUBLIC_BASE_URL=https://your-backend.onrender.com

# CORS
CORS_ORIGINS=*
