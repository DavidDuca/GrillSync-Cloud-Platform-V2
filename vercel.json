{
  "version": 2,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/sync/:path*",      "destination": "/api/[...path]" },
    { "source": "/api/:path*",       "destination": "/api/[...path]" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
